---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada | Mentora">
  <main class="bg-background">
    <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 md:py-32">
      <p class="section-eyebrow">Error 404</p>
      <h1 class="section-title">Página no encontrada</h1>
      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Lo sentimos, no pudimos encontrar lo que buscabas. Es posible que la
        página haya sido movida o que nunca haya existido.
      </p>
      <p class="mt-6 font-display text-lg font-bold text-primaryhover sm:text-xl">
        ¿Quieres regresar al inicio y seguir explorando?
      </p>
      <a class="btn-primary mt-8" href="/">Volver al inicio</a>
    </section>
  </main>
</Layout>
