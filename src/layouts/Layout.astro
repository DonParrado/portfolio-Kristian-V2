---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import WhatsAppFloat from "../components/layout/WhatsAppFloat.astro";
import CookieBanner from "../components/cookies/CookieBanner.astro";
import { withBase } from "../utils/urls";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Soy Kristian Iliev, terapeuta emocional, y te acompaño en tu proceso de transformación personal, tanto de forma presencial como online."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <meta property="og:title" content="Mentora | Terapeuta Emocional" />
    <meta
      property="og:description"
      content="Soy Kristian Iliev, terapeuta emocional, y te acompaño en tu proceso de transformación personal, tanto de forma presencial como online."
    />
    <meta name="google-site-verification" content="940c353974c1dada" />
    <meta
      property="og:image"
      content={new URL(withBase("images/logo.png"), Astro.url.origin).href}
    />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, Astro.url.origin).href}
    />
    <meta property="og:type" content="website" />
    <link rel="icon" href={withBase("favicon.ico")} type="image/x-icon" />
    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, Astro.url.origin).href}
    />
    <title>{title}</title>

    <!-- Consent Mode v2: los tags de Google solo se cargan tras aceptar analítica o publicidad. -->
    <script is:inline>
      (function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;

        gtag("consent", "default", {
          ad_storage: "denied",
          analytics_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          functionality_storage: "granted",
          security_storage: "granted",
          wait_for_update: 500,
        });

        var googleLoaded = false;
        var tidycalLoaded = false;

        function loadTidycal() {
          if (tidycalLoaded) return;
          tidycalLoaded = true;
          var script = document.createElement("script");
          script.async = true;
          script.src = "https://asset-tidycal.b-cdn.net/js/embed.js";
          document.head.appendChild(script);
        }

        // TidyCal es de terceros: se carga con consentimiento o tras clic (servicio pedido).
        document.addEventListener(
          "click",
          function (event) {
            if (event.target.closest(".tidycal-embed")) loadTidycal();
          },
          true,
        );

        function loadGoogleTags(state) {
          if (googleLoaded || !state) return;
          var analytics = state.analytics === true;
          var ads = state.advertising === true;
          if (!analytics && !ads) return;
          googleLoaded = true;

          // Sin publicidad se limpia el gclid antes de cargar Google (pings cookieless).
          if (!ads) {
            try {
              var cleanUrl = new URL(window.location.href);
              if (cleanUrl.searchParams.has("gclid")) {
                cleanUrl.searchParams.delete("gclid");
                window.history.replaceState(
                  window.history.state,
                  "",
                  cleanUrl.toString(),
                );
              }
            } catch (error) {
              // URL no estándar: se deja como está.
            }
          }

          gtag("consent", "update", {
            ad_storage: ads ? "granted" : "denied",
            analytics_storage: analytics ? "granted" : "denied",
            ad_user_data: ads ? "granted" : "denied",
            ad_personalization: ads ? "granted" : "denied",
          });

          gtag("js", new Date());
          gtag("config", "AW-16915885750");

          var gtagScript = document.createElement("script");
          gtagScript.async = true;
          gtagScript.src =
            "https://www.googletagmanager.com/gtag/js?id=AW-16915885750";
          document.head.appendChild(gtagScript);

          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", "GTM-NR4MLXQC");

          loadTidycal();
        }

        window.addEventListener("cookieconsent:change", function (event) {
          loadGoogleTags(event.detail);
        });

        function bootstrap() {
          try {
            var raw = window.localStorage.getItem("cookie_consent_v1");
            if (!raw) return;
            var state = JSON.parse(raw);
            if (state && state.version === 1) loadGoogleTags(state);
          } catch (error) {
            // Consentimiento ilegible: se vuelve a preguntar.
          }
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", bootstrap);
        } else {
          bootstrap();
        }
      })();
    </script>
    <script>
      import "../scripts/cookie-consent";
      import { initGclidCollector } from "../scripts/gclid-collector";
      initGclidCollector();
    </script>
    <script src="../scripts/whatsapp.ts"></script>
    <meta
      name="google-site-verification"
      content="d7aMRTy08DCcJjtrM59LDdl2QIaxPwb_-4kia6ZcEyc"
    />
  </head>
  <body class="bg-white font-sans antialiased tracking-tight text-slate-800">
    <WhatsAppFloat />
    <Header />
    <slot />
    <Footer />
    <CookieBanner />

    <script>
      import { withBase } from "../utils/urls";

      const reveal = () => {
        const items = document.querySelectorAll("[data-reveal]");
        if (!items.length || !("IntersectionObserver" in window)) return;
        items.forEach((el) => {
          if (!el.classList.contains("is-visible")) el.classList.add("is-pending");
        });
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.remove("is-pending");
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 },
        );
        items.forEach((el) => observer.observe(el));
      };

      const scrollspy = () => {
        const links = document.querySelectorAll("[data-scrollspy-link]");
        const targets = document.querySelectorAll("[data-scrollspy-target]");
        if (!links.length || !targets.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const id = entry.target.getAttribute("id");
              links.forEach((link) => {
                link.classList.toggle(
                  "scrollspy-active",
                  link.getAttribute("href") === withBase(`#${id}`),
                );
              });
            });
          },
          { rootMargin: "-30% 0px -60% 0px" },
        );
        targets.forEach((target) => observer.observe(target));
      };

      reveal();
      scrollspy();
      document.addEventListener("astro:page-load", () => {
        reveal();
        scrollspy();
      });
    </script>
  </body>
</html>
