---
const UI = {
  accept:
    "rounded-full bg-primary px-4 py-3 text-sm font-extrabold text-primaryhover shadow-lg shadow-primary/30 transition hover:bg-primary/90 hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaryhover sm:flex-1 sm:px-8 sm:py-3.5 sm:text-base",
  reject:
    "rounded-full bg-primarydark px-4 py-3 text-sm font-extrabold text-primaryhover shadow-lg shadow-primarydark/30 transition hover:bg-primarydark/90 hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaryhover sm:flex-1 sm:px-8 sm:py-3.5 sm:text-base",
  more: "rounded-full px-5 py-2.5 text-sm font-medium text-primaryhover/70 underline-offset-4 transition hover:bg-primaryhover/5 hover:text-primaryhover hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaryhover",
  secondary:
    "rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaryhover",
  save: "rounded-full bg-primaryhover px-5 py-3 text-sm font-semibold text-white transition hover:bg-primaryhover/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaryhover",
};
---

<div
  id="cookie-modal"
  class="pointer-events-none fixed inset-0 z-40 hidden items-center justify-center overflow-hidden px-3 pt-24 pb-24 sm:px-4 md:pt-32"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-description"
>
  <div
    data-cookie-card
    class="pointer-events-auto relative my-auto max-h-full w-full max-w-xl overflow-y-auto overscroll-contain rounded-2xl bg-white p-4 shadow-2xl ring-1 ring-slate-200/70 sm:p-7 md:p-8"
  >
    <button
      type="button"
      data-cookie-action="close"
      aria-label="Cerrar aviso de cookies"
      title="Cerrar aviso de cookies"
      class="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full text-slate-400 transition-colors duration-300 hover:bg-slate-100 hover:text-primaryhover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primaryhover"
    >
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <div data-cookie-layer="main">
      <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-full bg-primary/20 sm:mb-4 sm:h-11 sm:w-11">
        <svg
          class="h-5 w-5 text-primaryhover sm:h-6 sm:w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"></path>
          <circle cx="8.5" cy="12" r="0.8" fill="currentColor" stroke="none"></circle>
          <circle cx="11" cy="16" r="0.8" fill="currentColor" stroke="none"></circle>
          <circle cx="15.5" cy="14" r="0.8" fill="currentColor" stroke="none"></circle>
        </svg>
      </div>

      <h2
        id="cookie-title"
        class="font-playfair text-xl font-bold text-primaryhover pr-10 sm:text-2xl"
      >
        Tu privacidad importa
      </h2>
      <div
        id="cookie-description"
        class="mt-2 space-y-2 text-[13px] leading-snug text-slate-600 sm:mt-3 sm:space-y-3 sm:text-sm sm:leading-relaxed"
      >
        <p>
          Nos gustaría entender mejor cómo se utiliza esta web y qué anuncios
          ayudan a que las personas nos encuentren.
        </p>
        <p>
          Para ello, además de las cookies necesarias, podemos utilizar cookies
          propias y de Google para analizar las visitas y medir los resultados
          de nuestra publicidad, siempre con tu permiso.
        </p>
        <p>Si las aceptas, nos ayudas a seguir mejorando este espacio.</p>
        <p class="text-xs">
          Más información en nuestra
          <a
            href="/politica-cookies"
            class="text-primaryhover/80 underline underline-offset-2 transition-colors duration-300 hover:text-primaryhover"
            >Política de cookies</a
          >.
        </p>
      </div>

      <div
        class="mt-4 grid grid-cols-2 items-stretch gap-2 sm:mt-6 sm:flex sm:items-center"
      >
        <button type="button" data-cookie-action="accept" class={UI.accept}>
          Aceptar todas
        </button>
        <button type="button" data-cookie-action="reject" class={UI.reject}>
          Rechazar
        </button>
        <button
          type="button"
          data-cookie-action="more"
          class={`${UI.more} col-span-2 justify-self-center sm:col-span-1`}
        >
          Saber más
        </button>
      </div>

      <p class="mt-3 text-[11px] leading-snug text-slate-400 sm:mt-5 sm:text-xs sm:leading-relaxed">
        Puedes cambiar tu decisión cuando quieras desde «Preferencias de
        cookies» en el pie de página.
      </p>
    </div>

    <div data-cookie-layer="details" class="hidden">
      <h2
        id="cookie-title-details"
        class="font-playfair text-lg font-bold text-primaryhover pr-10 sm:text-2xl"
      >
        Preferencias de cookies
      </h2>
      <p class="mt-1.5 text-xs leading-snug text-slate-600 sm:mt-3 sm:text-sm sm:leading-relaxed">
        Las cookies necesarias son imprescindibles para que la web funcione y
        no se pueden desactivar. El resto solo se activan si tú lo permites.
        Google Ads recibe el GCLID únicamente si activas «Publicidad».
      </p>

      <div class="mt-3 space-y-1 sm:mt-5 sm:space-y-3">
        <div
          class="flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-50 p-2 sm:gap-4 sm:p-3"
        >
          <span>
            <span class="block text-[13px] font-semibold text-slate-800 sm:text-sm"
              >Necesarias</span
            >
            <span class="block text-xs text-slate-500"
              >Siempre activas. No se pueden desactivar.</span
            >
          </span>
          <span
            class="shrink-0 rounded-full bg-primaryhover/10 px-3 py-1 text-xs font-semibold text-primaryhover"
            >Activas</span
          >
        </div>

        <label
          class="flex cursor-pointer items-center justify-between gap-2 rounded-xl border border-slate-200 p-2 transition hover:border-primaryhover/40 sm:gap-4 sm:p-3"
        >
          <span>
            <span class="block text-[13px] font-semibold text-slate-800 sm:text-sm"
              >Analítica</span
            >
            <span class="block text-xs text-slate-500"
              >Nos ayuda a entender cómo se usa la web (_ga, GTM).</span
            >
          </span>
          <span class="relative inline-flex shrink-0 items-center">
            <input
              type="checkbox"
              data-consent-toggle="analytics"
              class="peer sr-only"
              aria-label="Permitir cookies de analítica"
            />
            <span
              class="pointer-events-none h-6 w-11 rounded-full bg-slate-300 transition peer-checked:bg-primary peer-focus-visible:ring-2 peer-focus-visible:ring-primaryhover peer-focus-visible:ring-offset-2"></span>
            <span
              class="pointer-events-none absolute left-1 h-4 w-4 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
          </span>
        </label>

        <label
          class="flex cursor-pointer items-center justify-between gap-2 rounded-xl border border-slate-200 p-2 transition hover:border-primaryhover/40 sm:gap-4 sm:p-3"
        >
          <span>
            <span class="block text-[13px] font-semibold text-slate-800 sm:text-sm"
              >Publicidad / Google Ads</span
            >
            <span class="block text-xs text-slate-500"
              >Permite enviar el GCLID a Google para medir conversiones.</span
            >
          </span>
          <span class="relative inline-flex shrink-0 items-center">
            <input
              type="checkbox"
              data-consent-toggle="advertising"
              class="peer sr-only"
              aria-label="Permitir cookies de publicidad"
            />
            <span
              class="pointer-events-none h-6 w-11 rounded-full bg-slate-300 transition peer-checked:bg-primary peer-focus-visible:ring-2 peer-focus-visible:ring-primaryhover peer-focus-visible:ring-offset-2"></span>
            <span
              class="pointer-events-none absolute left-1 h-4 w-4 rounded-full bg-white shadow transition peer-checked:translate-x-5"></span>
          </span>
        </label>
      </div>

      <div
        class="mt-3 grid grid-cols-2 gap-1.5 sm:mt-6 sm:flex sm:flex-row sm:gap-2"
      >
        <button
          type="button"
          data-cookie-action="save"
          class={`${UI.save} col-span-2 sm:col-span-1`}
        >
          Guardar selección
        </button>
        <button type="button" data-cookie-action="accept" class={UI.accept}>
          Aceptar todas
        </button>
        <button type="button" data-cookie-action="reject" class={UI.secondary}>
          Rechazar
        </button>
      </div>

      <div
        class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-slate-500 sm:mt-5"
      >
        <a
          href="/politica-cookies"
          class="underline underline-offset-2 hover:text-primaryhover">Política de cookies</a
        >
        <a
          href="/documentos/avisoLegal.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2 hover:text-primaryhover">Aviso legal</a
        >
        <button
          type="button"
          data-cookie-action="back"
          class="ml-auto underline underline-offset-2 hover:text-primaryhover"
          >Volver</button
        >
      </div>
    </div>
  </div>
</div>

<script>
  import {
    getConsent,
    setConsent,
  } from "../../scripts/cookie-consent";

  // Cerrar con la X no decide nada: solo oculta el aviso durante la sesión.
  const DISMISS_KEY = "cookie_banner_dismissed";

  interface Refs {
    modal: HTMLElement;
    card: HTMLElement;
    main: HTMLElement;
    details: HTMLElement;
    analytics: HTMLInputElement;
    advertising: HTMLInputElement;
  }

  function refs(): Refs | null {
    const modal = document.querySelector<HTMLElement>("#cookie-modal");
    if (!modal) return null;
    return {
      modal,
      card: modal.querySelector<HTMLElement>("[data-cookie-card]")!,
      main: modal.querySelector<HTMLElement>('[data-cookie-layer="main"]')!,
      details: modal.querySelector<HTMLElement>('[data-cookie-layer="details"]')!,
      analytics: modal.querySelector<HTMLInputElement>(
        '[data-consent-toggle="analytics"]',
      )!,
      advertising: modal.querySelector<HTMLInputElement>(
        '[data-consent-toggle="advertising"]',
      )!,
    };
  }

  let lastFocused: HTMLElement | null = null;

  function showLayer(layer: "main" | "details"): void {
    const elements = refs();
    if (!elements) return;
    elements.main.classList.toggle("hidden", layer !== "main");
    elements.details.classList.toggle("hidden", layer !== "details");
    // Cada capa empieza arriba: al abrir desde el pie no aparece un scroll avanzado.
    elements.card.scrollTop = 0;
  }

  function focusFirst(): void {
    const elements = refs();
    if (!elements) return;
    const target = !elements.main.classList.contains("hidden")
      ? elements.main.querySelector<HTMLElement>('[data-cookie-action="accept"]')
      : elements.details.querySelector<HTMLElement>('[data-cookie-action="save"]');
    // preventScroll: enfocar no debe mover ningún scroll.
    target?.focus({ preventScroll: true });
  }

  function openModal(preferences: boolean, focus = true): void {
    const elements = refs();
    if (!elements) return;

    lastFocused = document.activeElement as HTMLElement | null;

    // Nunca se preselecciona una finalidad opcional.
    const saved = getConsent();
    elements.analytics.checked = saved?.analytics ?? false;
    elements.advertising.checked = saved?.advertising ?? false;

    showLayer(preferences ? "details" : "main");
    elements.modal.classList.remove("hidden");
    elements.modal.classList.add("flex");
    elements.card.scrollTop = 0;
    // Aviso no bloqueante: sin focus trap ni bloqueo de scroll.
    if (focus) requestAnimationFrame(focusFirst);
  }

  function closeModal(dismissed = false): void {
    const elements = refs();
    if (!elements) return;
    elements.modal.classList.add("hidden");
    elements.modal.classList.remove("flex");
    try {
      if (dismissed) sessionStorage.setItem(DISMISS_KEY, "1");
      else sessionStorage.removeItem(DISMISS_KEY);
    } catch {
      // sessionStorage no disponible: el aviso simplemente reaparecerá.
    }
    // Sin preventScroll, devolver el foco arrastraría la página hasta el botón del pie.
    if (lastFocused instanceof HTMLElement)
      lastFocused.focus({ preventScroll: true });
  }

  function decide(selection: {
    analytics: boolean;
    advertising: boolean;
  }): void {
    setConsent(selection);
    closeModal();
  }

  document.addEventListener("click", (event) => {
    const button = (event.target as Element)?.closest<HTMLElement>(
      "[data-cookie-action]",
    );
    if (!button) return;

    const elements = refs();
    if (!elements || !elements.modal.contains(button)) return;

    switch (button.dataset.cookieAction) {
      case "accept":
        decide({ analytics: true, advertising: true });
        break;
      case "reject":
        decide({ analytics: false, advertising: false });
        break;
      case "save":
        decide({
          analytics: elements.analytics.checked,
          advertising: elements.advertising.checked,
        });
        break;
      case "more":
        showLayer("details");
        focusFirst();
        break;
      case "back":
        showLayer("main");
        focusFirst();
        break;
      case "close":
        closeModal(true);
        break;
    }
  });

  window.addEventListener("cookieconsent:open", () => openModal(true));

  document.addEventListener("keydown", (event) => {
    const elements = refs();
    if (!elements || elements.modal.classList.contains("hidden")) return;

    if (event.key === "Escape") {
      // Igual que la X: cerrar no decide nada.
      event.preventDefault();
      closeModal(true);
    }
  });

  function bootstrap(): void {
    if (document.documentElement.dataset.cookieBannerReady) return;
    document.documentElement.dataset.cookieBannerReady = "true";
    let dismissed = false;
    try {
      dismissed = sessionStorage.getItem(DISMISS_KEY) === "1";
    } catch {
      // Sin sessionStorage, se muestra el aviso con normalidad.
    }
    // En la primera visita no se roba el foco.
    if (!getConsent() && !dismissed) openModal(false, false);
  }

  bootstrap();
  document.addEventListener("astro:page-load", bootstrap);
</script>
